# Copy this file to .env (or export these as real environment variables) before running the backend.

# MongoDB connection string. Default assumes MongoDB Compass/local server on the default port
# with a database named "motherplatform" (created automatically on first write).
MONGODB_URI=mongodb://localhost:27017/motherplatform

# JWT signing secret — MUST be changed to a long random string before any real deployment.
JWT_SECRET=please-generate-a-long-random-string-and-put-it-here
JWT_EXPIRATION_MS=86400000

# Where uploaded images/videos are stored on disk.
UPLOADS_DIR=./uploads

# Comma-separated list of frontend origins allowed to call this API.
# Mother frontend + each template's local dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000

# First-boot admin account (only created if no users exist yet). Change the password after first login.
ADMIN_EMAIL=admin@motherplatform.local
ADMIN_PASSWORD=ChangeMe123!
